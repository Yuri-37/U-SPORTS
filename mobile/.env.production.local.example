# Production values for build_release.ps1 (release APK).
# Copy to .env.production.local and fill in. That filename is gitignored by the
# .env.*.local rule, so the key never gets committed.
#
# These are COMPILE-TIME values baked into the APK — see lib/config/env.dart.
# Unlike .env (used by run_physical.ps1 / run_emulator.ps1 for local dev), these
# must point at the deployed services, not localhost/LAN.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon key — the public client key, protected by RLS. It ships inside
# every APK and the web bundle by design. Never put the service_role key here.
SUPABASE_ANON_KEY=

# Deployed API base URL, including the /api suffix.
API_URL=https://your-api-host/api
