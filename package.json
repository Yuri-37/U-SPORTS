{
  "name": "u-sports",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev": "concurrently -n web,server -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:server\"",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "env:init": "powershell -ExecutionPolicy Bypass -File scripts/init-local-env.ps1",
    "db:combine": "powershell -ExecutionPolicy Bypass -File scripts/combine-migrations.ps1",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:seed:dev": "npx supabase db query --local -f supabase/seed_dev_people.sql --agent=no",
    "db:link": "npx supabase link",
    "db:repair-baseline": "powershell -ExecutionPolicy Bypass -File scripts/supabase-repair-baseline.ps1",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "seed:insights-demo": "pnpm --filter server seed:insights-demo",
    "seed:insights-demo:player": "pnpm --filter server seed:insights-demo:player",
    "seed:mock-brackets": "pnpm --filter server seed:mock-brackets",
    "lint": "eslint apps/web/src apps/server/src",
    "lint:fix": "eslint apps/web/src apps/server/src --fix",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8"
  }
}
