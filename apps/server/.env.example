PORT=3001
SUPABASE_URL=http://127.0.0.1:54321
# Anon key — used server-side only to re-verify a user's current password (sign-in check) before a password change.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
WEB_URL=http://localhost:5173

# Direct Postgres connection — bypasses PostgREST schema cache (needed for roster_context updates).
# Local Supabase: omitted when SUPABASE_URL is http://127.0.0.1:54321 — the API auto-uses
# postgresql://postgres:postgres@127.0.0.1:54322/postgres (override password with SUPABASE_DB_PASSWORD).
SUPABASE_DB_URL=
# SUPABASE_DB_PASSWORD=postgres
# SUPABASE_DB_PORT=54322

# Optional — mobile push notifications (FCM). Without this, notifications are
# still written to the in-app inbox as normal; push is just skipped.
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key, then paste the entire downloaded JSON file as one line here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Keys the readable passwords handed to new accounts (e.g. Brave-Otter-372). Set a long random
# value in production and keep it stable; falls back to the service-role key if unset.
ACCOUNT_PASSWORD_SECRET=

# First-boot Super Admin (only used when no admin exists yet). If these are unset a built-in
# default account is created -- change its password straight away.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_NAME=

# "Choose your own password" emails for new accounts are on by default; set to false to stop them.
# INVITE_EMAILS_ENABLED=false

# Comma-separated addresses let through the @nu-dasma.edu.ph staff-email check
# anyway -- for testing the staff account-creation flow against a real inbox
# when you have no @nu-dasma.edu.ph mailbox to test with. Empty/unset means no
# exceptions. Also set VITE_STAFF_EMAIL_TEST_ALLOWLIST (same value) in the web
# app's env so the "Add Admin"/"Add Organizer" form doesn't block it client-side.
# STAFF_EMAIL_TEST_ALLOWLIST=you@gmail.com
